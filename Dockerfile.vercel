FROM composer:2 AS deps
WORKDIR /app
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-interaction --no-progress --optimize-autoloader --no-scripts

FROM dunglas/frankenphp:1-php8.4

RUN install-php-extensions bcmath gd pdo_mysql pdo_pgsql pdo_sqlite zip

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates gnupg \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_20.x nodistro main" > /etc/apt/sources.list.d/nodesource.list \
    && apt-get update && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=deps /usr/bin/composer /usr/bin/composer
COPY --from=deps /app/vendor ./vendor
COPY Caddyfile /etc/caddy/Caddyfile
COPY . .

RUN rm -f bootstrap/cache/*.php \
    && composer dump-autoload --optimize --no-interaction \
    && npm ci \
    && npm run build \
    && rm -rf node_modules

ENV LOG_CHANNEL=stderr \
    SESSION_DRIVER=database \
    CACHE_STORE=database \
    VIEW_COMPILED_PATH=/tmp/nutricycle/views

EXPOSE 80

CMD sh -c "php artisan migrate --force && php artisan db:seed --force && frankenphp run --config /etc/caddy/Caddyfile"
